# cp .env.example .env, paste your key (https://aistudio.google.com/apikey),
# then check it: uv run python api_key.py. Never commit .env.
GEMINI_API_KEY=paste-your-key-here

# Only needed to (re)download the corpus from SEC EDGAR. The SEC fair-access
# policy rejects requests (HTTP 403) unless they declare who is downloading:
# "<organisation or name> <contact email>".
SEC_USER_AGENT=
